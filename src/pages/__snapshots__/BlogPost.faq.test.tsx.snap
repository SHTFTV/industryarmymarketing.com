exports[`BlogPost FAQ rendering matches FAQPage JSON-LD > /ai-hallucinations-real-business-problem: FAQPage JSON-LD matches stored snapshot 1`] = `
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In a fresh chat with no prior context we asked 'Who owns Weddings.io?' The LLM fabricated a corporate split — describing weddings.io as managed by one entity in BC and an imaginary 'AI Platform' division incorporated in Ontario. Neither camp exists. When pressed it doubled down, invented a feature stack, and warned users about 'App Store Confusion' between two entities it had manufactured."
      },
      "name": "What actually happened?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When an LLM encounters two similarly named identifiers in training data — a domain (weddings.io) and a corporate name (Weddings.io Inc.) — it does not return a null. It pattern-matches, finds the most statistically plausible relationship, and presents it as fact. The result maps directly onto Initial Interest Confusion (Brookfield Communications v. West Coast Entertainment, U.S. 9th Circuit) and first-impression confusion doctrine (Sleep Country Canada v. Sears Canada, Ontario Superior Court)."
      },
      "name": "Why do LLMs hallucinate this way?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Industry Army Marketing. Continuous ICANN WHOIS registration since May 13, 2015. 78 Internet Archive captures. Zero affiliation with 'Weddings.io Inc.' (Ontario Reg. No. 74761 8627 RT0001), aiweddings.io, or any other similarly named entity."
      },
      "name": "Who owns weddings.io?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Live today: weddings.io, roofers.io, demolition.io, framers.io, financialadvisors.io, videographers.io, errands.io, backhaul.io, aeo.io. Coming soon: insurance-brokers.io, cannabinoid.io. Each is an active industry-specific hub in the hub-and-spoke model, not a parked page — and each carries the same LLM hallucination risk that requires public pages, schema, press, directory listings, and archive captures to correct."
      },
      "name": "Which other .io domains are in the IAM portfolio?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Portfolio. Not a one-off. I have been quoted in Business in Vancouver (biv.com) on digital vendor infrastructure since 2010–2011 — nineteen years of continuous operation in this exact space. The hub-and-spoke architecture is deliberate: one industry-specific .io hub per vertical (roofers.io, videographers.io, backhaul.io, errands.io, financialadvisors.io, aeo.io, etc.), each with its own feeder sites, city-locked listings, and vendor tools. Going industry-specific is how we protect the disruptor position in the directories game — no one can steal a vertical we already occupy end-to-end."
      },
      "name": "Is this really a portfolio or just weddings.io?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Four steps. (1) Test each domain against major LLMs on a clean chat and document what the machine invents. (2) Put the correct information on public record — government filings where applicable, press releases, ownership declaration pages. (3) Ship Organization schema on every domain so Google's Knowledge Graph and AI retrieval systems have machine-readable ground truth. (4) Treat every domain as an entity that needs explicit indexing — the machine cannot hallucinate a coherent entity if the correct one is already clearly and multiply defined in indexed data."
      },
      "name": "What should other domain-portfolio operators do?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — same story, wider frame. The Knot and WeddingWire (WeddingPro) face 200+ FTC complaints since 2018, a class action filed April 30, 2025, and Senator Grassley pressing for an FTC investigation. The Knot denies all allegations; the case is pending. Independent vendors are actively looking for alternatives. weddings.io was built for that market: plans from $10/month, free signups, territory-locked listings."
      },
      "name": "Is this related to the wedding platform controversy?"
    }
  ]
}
`;

exports[`BlogPost FAQ rendering matches FAQPage JSON-LD > /aibuildr-geo-engine: FAQPage JSON-LD matches stored snapshot 1`] = `
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO optimizes for ranking in Google's blue links. GEO (Generative Engine Optimization) optimizes for citation in AI-generated answers (Perplexity, ChatGPT, Claude, Google AI Overviews). GEO requires structured data, verifiable claims, and citation-friendly formatting — overlapping but distinct from classical SEO."
      },
      "name": "What is GEO and how is it different from SEO?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AEO (Answer Engine Optimization) is the broader umbrella covering all answer surfaces: voice assistants (Alexa, Siri, Google Assistant), featured snippets, People Also Ask, and AI Overviews. GEO is the LLM-specific subset of AEO focused on generative-AI citation."
      },
      "name": "What is AEO and how is it different from GEO?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — Perplexity, ChatGPT search, and Google AI Overviews routinely cite named businesses with linked sources. The IAM network's structured-data approach and aged-domain authority makes its territory partners frequent citation targets."
      },
      "name": "Do AI engines actually cite specific contractors?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "LLMs index public LinkedIn posts and Twitter/X content as training and retrieval signals. AIBuildr cross-posts every territory content piece to both platforms with consistent named-entity formatting, reinforcing the citation chain."
      },
      "name": "What about LinkedIn and Twitter/X for GEO?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We track citations in Perplexity and ChatGPT search responses for territory-relevant queries, monitor AI Overview appearances for trade+city searches, and report monthly on AI-channel referral traffic in your analytics."
      },
      "name": "How do you measure GEO performance?"
    },
    {
      "@type": "Question",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Included with every $10 IAM territory subscription. The GEO layer applies automatically to your listing across every IAM domain you claim."
      },
      "name": "What does AIBuildr cost?"
    }
  ]
}
`;

