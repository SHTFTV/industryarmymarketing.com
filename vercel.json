{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/industry-army/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/mark-ett.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/marketing/snow-removal",
      "destination": "/snow-removal-marketing",
      "permanent": true
    },
    {
      "source": "/pseo-for-snow-removal-companies",
      "destination": "/snow-removal-marketing",
      "permanent": true
    },
    {
      "source": "/marketing/steel-stud-drywall",
      "destination": "/steel-stud-drywall-marketing",
      "permanent": true
    },
    {
      "source": "/steel-stud-marketing",
      "destination": "/steel-stud-drywall-marketing",
      "permanent": true
    },
    {
      "source": "/drywall-contractor-marketing",
      "destination": "/steel-stud-drywall-marketing",
      "permanent": true
    },
    {
      "source": "/niches/steel-stud",
      "destination": "/steel-stud-drywall-marketing",
      "permanent": true
    }
  ]
}
